<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kd_slam2_ros</name>
  <version>0.0.0</version>
  <description>ROS2 side of kd_slam2: rosbag2 reader/writer plugin for kd_io, bag converters</description>
  <maintainer email="grisetti@diag.uniroma1.it">giorgio</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>srrg2_core</depend>
  <depend>srrg2_solver</depend>
  <depend>kd_slam2</depend>
  <depend>kd_slam2_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
